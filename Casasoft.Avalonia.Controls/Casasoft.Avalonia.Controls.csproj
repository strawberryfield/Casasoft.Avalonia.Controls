<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Casasoft.Avalonia.Controls</AssemblyName>
    <RootNamespace>Casasoft.Avalonia.Controls</RootNamespace>
    <Authors>Roberto Ceccarelli - Casasoft</Authors>
    <Product>Casasoft Avalonia Controls</Product>
    <Description>AvaloniaUI porting of the custom controls used by the WPF-only Casasoft.Xaml.Controls package: FileTextBox, FileTextBoxLabel, NumericUpDown, ImageViewer, PangoTextEditor.</Description>
    <Copyright>copyright (c) 2026 Roberto Ceccarelli - Casasoft</Copyright>
    <RepositoryUrl>https://github.com/strawberryfield/Casasoft.Avalonia.Controls</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/strawberryfield/Casasoft.Avalonia.Controls</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageOutputPath />
  </PropertyGroup>

  
  <!--
    NOTE: do NOT add an explicit "<AvaloniaResource Include="**\*.axaml" />" item
    group here. The Avalonia NuGet package's own MSBuild targets already glob and
    include every *.axaml file as AvaloniaResource automatically; adding the same
    glob explicitly makes each file get processed twice and the compiler reports
    AVLN2002 "Duplicate x:Class directive" for every control.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.15.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
